{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drift",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS"
    }
  ]
}
