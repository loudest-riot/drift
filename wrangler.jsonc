{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drift",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driftdb",
      "database_id": "248fea96-505a-42ce-8ad5-c0de1c03d99e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "drift-photos"
    }
  ]
}
